# Copy to .env.local (dev) — EXPO_PUBLIC_* values are bundled into the app, so ONLY put
# public/anon values here. Never put the service role key or any AI/RevenueCat secret key here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
